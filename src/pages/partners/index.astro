---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const partners = await getCollection("partners");
const byOrder = (a: (typeof partners)[number], b: (typeof partners)[number]) => a.data.order - b.data.order;
const mainPartners = partners.filter((partner) => partner.data.type === "main").sort(byOrder);
const hostingPartners = partners.filter((partner) => partner.data.type === "hosting").sort(byOrder);
const getEventLinks = (partner: (typeof partners)[number]) => {
  if (partner.data.eventLinks.length > 0) {
    return partner.data.eventLinks;
  }

  if (partner.data.eventUrl) {
    return [{
      href: partner.data.eventUrl,
      label: partner.data.eventLabel || "View event",
    }];
  }

  return [];
};
---

<BaseLayout
  title="partners"
  description="Partners and collaborators of the Agentic Builders Collective — organisations we work with regularly."
>
  <h1 class="page-title">Partners</h1>

  <p class="page-intro">
    Organisations we collaborate with regularly for meetups, workshops, and community building.
  </p>

  <section class="partner-section" aria-labelledby="main-partners">
    <h2 id="main-partners" class="section-label">Main Partners</h2>

    <div class="partners-grid">
      {mainPartners.map((partner) => (
        <a
          href={partner.data.url || undefined}
          target={partner.data.url ? "_blank" : undefined}
          rel={partner.data.url ? "noopener noreferrer" : undefined}
          class="partner-card"
        >
          <div class="partner-logo">
            {partner.data.logo ? (
              <img src={partner.data.logo} alt={`${partner.data.name} logo`} loading="lazy" />
            ) : (
              <div class="partner-logo-placeholder">{partner.data.name.charAt(0)}</div>
            )}
          </div>
          <h3 class="partner-name">{partner.data.name}</h3>
          {partner.data.description && (
            <p class="partner-description">{partner.data.description}</p>
          )}
        </a>
      ))}
    </div>
  </section>

  <section class="partner-section" aria-labelledby="hosting-partners">
    <h2 id="hosting-partners" class="section-label">Hosting Partners</h2>

    <div class="hosting-list">
      {hostingPartners.map((partner) => (
        <article class="hosting-card">
          <div>
            <h3 class="partner-name">
              {partner.data.url ? (
                <a href={partner.data.url} target="_blank" rel="noopener noreferrer">{partner.data.name}</a>
              ) : (
                partner.data.name
              )}
            </h3>
            {getEventLinks(partner).length > 0 ? (
              <div class="event-links">
                {getEventLinks(partner).map((eventLink) => (
                  <a class="event-link" href={eventLink.href}>
                    {eventLink.label}
                    <span class="inline-arrow" aria-hidden="true">▶</span>
                  </a>
                ))}
              </div>
            ) : (
              partner.data.description && (
                <p class="partner-description">{partner.data.description}</p>
              )
            )}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="partner-cta">
    <h2 class="section-label">Become a Partner</h2>
    <p>
      Want to collaborate with the Agentic Builders Collective? Reach out to us at{" "}
      <a href="mailto:hello@agenticbuilders.sg">hello@agenticbuilders.sg</a>
    </p>
  </section>
</BaseLayout>

<style>
  .page-intro {
    color: var(--muted);
    margin-bottom: 32px;
    max-width: 640px;
  }

  .partner-section {
    margin-bottom: 48px;
  }

  .partners-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 20px;
  }

  .partner-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 24px;
    background: var(--panel);
    text-decoration: none;
    transition: background 0.15s ease;
    border: 1px solid var(--line);
  }

  .partner-card:hover {
    background: var(--panel-strong);
  }

  .partner-logo {
    width: 100%;
    height: 86px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
  }

  .partner-logo img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .partner-logo-placeholder {
    width: 64px;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--box-bg);
    font-size: 1rem;
    font-weight: 700;
    color: var(--accent);
  }

  .partner-name {
    font-size: 1rem;
    font-weight: 600;
    margin: 0 0 8px 0;
  }

  .partner-name a {
    color: var(--text);
    text-decoration: none;
  }

  .partner-name a:hover {
    color: var(--accent);
  }

  .partner-description {
    font-size: 1rem;
    color: var(--muted);
    margin: 0;
    line-height: 1.4;
  }

  .hosting-list {
    display: grid;
    gap: 12px;
  }

  .hosting-card {
    padding: 18px 20px;
    background: var(--panel);
    border: 1px solid var(--line);
  }

  .event-links {
    display: grid;
    gap: 6px;
  }

  .event-link {
    align-items: center;
    color: var(--muted);
    column-gap: 8px;
    display: inline-flex;
    width: fit-content;
    font-size: 1rem;
    font-weight: 400;
    text-decoration: none;
    white-space: nowrap;
  }

  .event-link .inline-arrow {
    margin-left: 0;
    transform: none;
  }

  .event-link:hover {
    color: var(--accent);
  }

  .partner-cta {
    border-top: 1px solid var(--line);
    padding-top: 32px;
    margin-top: 16px;
  }

  .partner-cta p {
    color: var(--muted);
    max-width: 640px;
  }

  @media (max-width: 480px) {
    .partners-grid {
      grid-template-columns: 1fr;
    }

    .event-link {
      white-space: normal;
    }
  }
</style>
