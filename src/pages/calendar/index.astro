---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CalendarEventCard from "../../components/CalendarEventCard.astro";
import { getCollection } from "astro:content";

const allEvents = await getCollection("events");

const now = new Date();
const today = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate()));

const toUtcDate = (value: Date | string) => {
  const date = value instanceof Date ? value : new Date(value);
  return new Date(Date.UTC(date.getUTCFullYear(), date.getUTCMonth(), date.getUTCDate()));
};

const monthNames = [
  "January", "February", "March", "April", "May", "June",
  "July", "August", "September", "October", "November", "December"
];

const monthKeyOf = (event: typeof allEvents[number]) => {
  const d = toUtcDate(event.data.date);
  return `${d.getUTCFullYear()}-${String(d.getUTCMonth() + 1).padStart(2, "0")}`;
};
const formatMonth = (key: string) => {
  const [year, month] = key.split("-");
  return `${monthNames[parseInt(month) - 1]} ${year}`;
};
const monthOnly = (key: string) => monthNames[parseInt(key.split("-")[1]) - 1];

// Upcoming events grouped by month, ascending.
const upcomingByMonth = new Map<string, typeof allEvents>();
for (const event of allEvents) {
  if (toUtcDate(event.data.date) >= today) {
    const key = monthKeyOf(event);
    if (!upcomingByMonth.has(key)) upcomingByMonth.set(key, []);
    upcomingByMonth.get(key)!.push(event);
  }
}
const upcomingMonths = [...upcomingByMonth.keys()].sort();

// Past events grouped by year, then month (both most-recent-first).
const pastByYear = new Map<string, Map<string, typeof allEvents>>();
for (const event of allEvents) {
  if (toUtcDate(event.data.date) < today) {
    const key = monthKeyOf(event);
    const year = key.split("-")[0];
    if (!pastByYear.has(year)) pastByYear.set(year, new Map());
    const months = pastByYear.get(year)!;
    if (!months.has(key)) months.set(key, []);
    months.get(key)!.push(event);
  }
}
const pastYears = [...pastByYear.keys()].sort().reverse();
---

<BaseLayout
  title="calendar"
  description="Monthly meetup calendar for the Agentic Builders Collective in Singapore."
>
  <h1 class="page-title calendar-title">
    <span class="calendar-title-label">Calendar</span><span class="calendar-title-colon">:</span>
    <span class="calendar-title-nav">
      <a href="/events/">Back to Events</a>
    </span>
  </h1>

  <p class="page-intro">
    Monthly meetup dates for the Agentic Builders Collective.
  </p>

  <div class="calendar-container">
    {upcomingMonths.map((monthKey) => (
      <section class="calendar-month">
        <h2 class="month-heading">{formatMonth(monthKey)}</h2>
        <div class="month-events">
          {upcomingByMonth
            .get(monthKey)!
            .sort((a, b) => new Date(a.data.date).getTime() - new Date(b.data.date).getTime())
            .map((event) => (
              <CalendarEventCard event={event} isPast={false} />
            ))}
        </div>
      </section>
    ))}

    {pastYears.map((year) => {
      const months = [...pastByYear.get(year)!.keys()].sort().reverse();
      return (
        <details class="calendar-year">
          <summary class="collapsible-heading">{year}</summary>
          <div class="calendar-year-body">
            {months.map((monthKey) => (
              <section class="calendar-month">
                <h2 class="month-heading">{monthOnly(monthKey)}</h2>
                <div class="month-events">
                  {pastByYear
                    .get(year)!
                    .get(monthKey)!
                    .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
                    .map((event) => (
                      <CalendarEventCard event={event} isPast={true} />
                    ))}
                </div>
              </section>
            ))}
          </div>
        </details>
      );
    })}
  </div>
</BaseLayout>

<style>
  .calendar-title {
    align-items: center;
    display: flex;
    flex-wrap: nowrap;
    overflow-x: auto;
  }

  .calendar-title::before {
    flex: 0 0 auto;
  }

  .calendar-title-label {
    color: var(--logo-gradient-start);
  }

  .calendar-title-colon {
    color: #555;
  }

  .calendar-title-nav {
    align-items: center;
    display: inline-flex;
    gap: 8px;
    margin-left: 8px;
    white-space: nowrap;
  }

  .calendar-title-nav a {
    color: var(--logo-gradient-end);
    text-decoration: none;
  }

  .calendar-title-nav a:hover,
  .calendar-title-nav a:focus-visible {
    text-decoration: underline;
  }

  .page-intro {
    color: var(--muted);
    margin-bottom: 32px;
    max-width: 640px;
  }

  .calendar-container {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .month-heading {
    font-size: 18px;
    font-weight: 600;
    margin: 0 0 16px 0;
    color: var(--accent);
  }

  .month-events {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  /* Year collapse bars for past events (matches the Events page). */
  .calendar-year {
    display: block;
  }

  .calendar-year-body {
    display: flex;
    flex-direction: column;
    gap: 32px;
    margin-top: 24px;
  }

  .collapsible-heading {
    align-items: center;
    border-bottom: 1px solid var(--line);
    color: var(--accent);
    cursor: pointer;
    display: flex;
    font-size: 18px;
    font-weight: 600;
    justify-content: space-between;
    list-style: none;
    padding-bottom: 12px;
    width: 100%;
  }

  .collapsible-heading::-webkit-details-marker {
    display: none;
  }

  .collapsible-heading::after {
    color: #555;
    content: "[+]";
    margin-left: auto;
  }

  .calendar-year[open] > .collapsible-heading::after {
    content: "[-]";
  }
</style>
