---
import type { CollectionEntry } from "astro:content";

interface Props {
  event: CollectionEntry<"events">;
  isPast: boolean;
}

const { event, isPast } = Astro.props;
const isTentative = event.data.tentative ?? false;

const date = new Date(event.data.date);
const utc = new Date(Date.UTC(date.getUTCFullYear(), date.getUTCMonth(), date.getUTCDate()));
const day = utc.getUTCDate();
const weekday = utc.toLocaleDateString("en-SG", { weekday: "short", timeZone: "UTC" });
---

<a
  href={`/events/#${event.id}`}
  class={`event-card ${isTentative ? "tentative" : "confirmed"} ${isPast ? "past" : ""}`}
>
  <div class="event-date">
    <span class="event-day">{day}</span>
    <span class="event-weekday">{weekday}</span>
  </div>
  <div class="event-info">
    <h3 class="event-title">{event.data.title}</h3>
    <div class="event-meta">
      {event.data.time && <span class="event-time">{event.data.time}</span>}
      {event.data.venue && <span class="event-venue">{event.data.venue}</span>}
    </div>
    {isTentative && (
      <div class="event-tags">
        <span class="tag tentative">tentative</span>
      </div>
    )}
  </div>
</a>

<style>
  .event-card {
    display: flex;
    gap: 16px;
    padding: 16px;
    background: var(--panel);
    border-left: 3px solid var(--line);
    text-decoration: none;
    transition: background 0.15s ease;
  }

  .event-card:hover {
    background: var(--panel-strong);
  }

  .event-card.confirmed {
    border-left-color: #4ade80;
  }

  .event-card.tentative {
    border-left-color: #fbbf24;
  }

  .event-card.past {
    opacity: 0.6;
  }

  .event-date {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-width: 48px;
    padding: 4px 8px;
    background: var(--box-bg);
    border-radius: var(--radius-sm);
  }

  .event-day {
    font-size: 1rem;
    font-weight: 700;
    line-height: 1;
  }

  .event-weekday {
    font-size: 1rem;
    color: var(--muted);
    margin-top: 2px;
    opacity: 0.75;
  }

  .event-info {
    flex: 1;
    min-width: 0;
  }

  .event-title {
    font-size: 1rem;
    font-weight: 600;
    margin: 0 0 6px 0;
    line-height: 1.3;
  }

  .event-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    font-size: 1rem;
    color: var(--muted);
  }

  .event-meta span {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .event-tags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin-top: 8px;
  }

  .tag {
    display: inline-block;
    padding: 2px 8px;
    font-size: 1rem;
    font-weight: 500;
    border-radius: 2px;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .tag.tentative {
    background: rgba(251, 191, 36, 0.15);
    color: #fbbf24;
  }

  @media (max-width: 480px) {
    .event-card {
      flex-direction: column;
      gap: 12px;
    }

    .event-date {
      flex-direction: row;
      gap: 6px;
      min-width: unset;
      align-self: flex-start;
    }

  }
</style>
